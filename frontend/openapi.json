    "/api/schema/events": {
      "get": {
        "tags": [
          "schema"
        ],
        "summary": "Event Schema",
        "operationId": "event_schema_api_schema_events_get",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "200": {
            "description": "Event union",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TurnStartedEvent"
                    },
                    {
                      "$ref": "#/components/schemas/TokenEvent"
                    },
                    {
                      "$ref": "#/components/schemas/StepEvent"
                    },
                    {
                      "$ref": "#/components/schemas/GuardrailEvent"
                    },
                    {
                      "$ref": "#/components/schemas/EscalationEvent"
                    },
                    {
                      "$ref": "#/components/schemas/AnswerRetractedEvent"
                    },
                    {
                      "$ref": "#/components/schemas/TranscriptEvent"
                    },
                    {
                      "$ref": "#/components/schemas/TraceEvent"
                    },
                    {
                      "$ref": "#/components/schemas/UsageEvent"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorEvent"
                    },
                    {
                      "$ref": "#/components/schemas/TurnCompletedEvent"
                    }
                  ],
                  "title": "Response 200 Event Schema Api Schema Events Get",
                  "discriminator": {
                    "propertyName": "type",
                    "mapping": {
                      "turn_started": "#/components/schemas/TurnStartedEvent",
                      "token": "#/components/schemas/TokenEvent",
                      "step_started": "#/components/schemas/StepEvent",
                      "step_completed": "#/components/schemas/StepEvent",
                      "step_failed": "#/components/schemas/StepEvent",
                      "guardrail": "#/components/schemas/GuardrailEvent",
                      "escalation": "#/components/schemas/EscalationEvent",
                      "answer_retracted": "#/components/schemas/AnswerRetractedEvent",
                      "transcript": "#/components/schemas/TranscriptEvent",
                      "trace": "#/components/schemas/TraceEvent",
                      "usage": "#/components/schemas/UsageEvent",
                      "error": "#/components/schemas/ErrorEvent",
                      "turn_completed": "#/components/schemas/TurnCompletedEvent"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
