# Copy to backend/.env and fill in the secrets. Every value below is a Settings field (backend/app/config.py).

# --- Infrastructure ---
DATABASE_URL=postgresql://nimbus:nimbus@localhost:5433/nimbus
TEST_DATABASE_URL=postgresql://nimbus:nimbus@localhost:5433/nimbus_test
FRONTEND_ORIGIN=http://localhost:3000

# --- Providers (secrets: never commit real values) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=

# --- Models ---
AGENT_MODEL=gpt-4.1-mini
SMALL_MODEL=gpt-4.1-mini
FALLBACK_MODEL=claude-haiku-5-5
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Retrieval and guardrails (tuned by evals/threshold_sweep.py) ---
RAG_T_LOW=0.30
RAG_T_HIGH=0.45
RAG_TOP_K=5

# --- Resilience ---
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=0.5
AGENT_MAX_ITERATIONS=6

# --- Cost and abuse protection ---
DAILY_BUDGET_USD=5
CHAT_RATE_PER_MIN=20
VOICE_CALLS_PER_HOUR=5
VOICE_MAX_SECONDS=600
VOICE_IDLE_SECONDS=60
VOICE_HISTORY_TURNS=10

# --- Frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
